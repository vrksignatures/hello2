<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Minimized Pill Mode -->
    <LinearLayout
        android:id="@+id/pillContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPillState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• BOT"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Expanded Control Panel -->
    <LinearLayout
        android:id="@+id/expandedContainer"
        android:layout_width="278dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_overlay_panel"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Top Drag Bar: State Badge + Fast Indicator + Minimize + Close -->
        <LinearLayout
            android:id="@+id/dragHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStateBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="IDLE"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFastBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="FAST: OFF"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnMinimize"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="•"
                android:textColor="#E2E8F0"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloseOverlay"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="2dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FCA5A5"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Conditional High-Visibility STOP ALARM Button -->
        <Button
            android:id="@+id/btnStopAlarm"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_stop_alarm"
            android:text="STOP ALARM"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Live Counters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCountSuccess"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OK: 0"
                android:textColor="#4ADE80"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCountSkipped"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SKIP: 0"
                android:textColor="#FBBF24"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCountErrors"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ERR: 0"
                android:textColor="#F87171"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Progress & Current Target -->
        <TextView
            android:id="@+id/tvProgressSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Processed 0 / 125"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvCurrentRetailer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Target: --"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLiveStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Open Customers and tap ▶ START"
            android:textColor="#CBD5E1"
            android:textSize="11sp" />

        <!-- Primary Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartPause"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1.5"
                android:backgroundTint="#16A34A"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="▶ START"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnResetTodayOverlay"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#334155"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="RESET"
                android:textColor="#F8FAFC"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
